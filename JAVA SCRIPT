
async function signUp() {
  const email = document.querySelector('#email').value.trim();
  const password = document.querySelector('#password').value;
  const displayName = document.querySelector('#displayName').value.trim();

  if (!displayName || displayName.length < 3) {
    return showAuthMessage('Choose a nickname of at least 3 characters.');
  }

  if (password.length < 8) {
    return showAuthMessage('Use a password of at least 8 characters.');
  }

  const { error } = await supabaseClient.auth.signUp({
    email,
    password,
    options: {
      data: { display_name: displayName }
    }
  });

  showAuthMessage(error
    ? error.message
    : 'Account created! Check your email if confirmation is required.');
}

async function signIn() {
  const email = document.querySelector('#email').value.trim();
  const password = document.querySelector('#password').value;

  const { error } = await supabaseClient.auth.signInWithPassword({
    email,
    password
  });

  if (error) showAuthMessage(error.message);
  else {
    showAuthMessage('Successfully logged in!');
    await refreshPlayer();
  }
}

async function signOut() {
  const { error } = await supabaseClient.auth.signOut();
  if (error) return showAuthMessage(error.message);

  currentUser = null;
  currentProfile = null;
  showAuthMessage('Logged out.');
  updatePlayerDisplay();
}

function showAuthMessage(message) {
  document.querySelector('#authMessage').textContent = message;
}

async function refreshPlayer() {
  const { data: { user } } =
    await supabaseClient.auth.getUser();

  currentUser = user;

  if (!user) {
    currentProfile = null;
    updatePlayerDisplay();
    return;
  }

  const { data, error } = await supabaseClient
    .from('profiles')
    .select('id, display_name, xp')
    .eq('id', user.id)
    .single();

  if (error) {
    showAuthMessage(error.message);
    return;
  }

  currentProfile = data;
  updatePlayerDisplay();
}

function updatePlayerDisplay() {
  const status = document.querySelector('#accountStatus');

  status.textContent = currentProfile
    ? `${currentProfile.display_name} — ${currentProfile.xp} XP`
    : 'Sign in to save your XP online.';
}

supabaseClient.auth.onAuthStateChange(() => {
  setTimeout(refreshPlayer, 0);
});

refreshPlayer();
